{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/ssot/standards-lock/v1",
  "title": "Wellmanifest standards lock v1",
  "description": "Formal single source of truth for the Wellmanifest standards a pack depends on: revision, contract digest, migration path, and adopter update policy. Drift is never silent; merge is never automatic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema": { "const": "wellmanifest.standards-lock/v1" },
    "version": { "$ref": "#/$defs/semver" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/standardPin" }
    },
    "migrations": {
      "type": "array",
      "items": { "$ref": "#/$defs/migration" }
    },
    "updatePolicy": { "$ref": "#/$defs/updatePolicy" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "standardPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "version", "repository", "revision", "contracts"],
      "properties": {
        "standard": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semver" },
        "repository": { "type": "string", "format": "uri" },
        "revision": { "$ref": "#/$defs/revision" },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/contractPin" }
        }
      }
    },
    "contractPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string", "format": "uri" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "steps"],
      "properties": {
        "from": { "$ref": "#/$defs/semver" },
        "to": { "$ref": "#/$defs/semver" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "notes": { "type": "string", "maxLength": 800 }
      }
    },
    "updatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge"],
      "properties": {
        "onNewCompatible": { "enum": ["create_pr", "create_ticket", "none"] },
        "onBreaking": { "enum": ["create_ticket", "block", "none"] },
        "merge": {
          "enum": ["trusted-validator", "manual"]
        }
      }
    }
  }
}
