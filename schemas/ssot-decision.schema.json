{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/ssot/decision/v1",
  "title": "Wellmanifest SSOT decision document v1",
  "description": "Canonical SSOT classification and proposed next actions. Propose-only: the document never authorizes edits, deletes, or merges.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "context",
    "policy",
    "decisions",
    "questions"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema": { "const": "wellmanifest.ssot/decision/v1" },
    "id": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semver" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 400 },
    "context": { "$ref": "#/$defs/context" },
    "policy": { "$ref": "#/$defs/pinPolicy" },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "kind": {
      "enum": [
        "generated_mirror",
        "vendored_copy",
        "facade",
        "allowed_divergence",
        "real_fork",
        "same_file_noise",
        "query_namespace",
        "served_artifact",
        "inventory_vs_runtime",
        "capability_surface",
        "locale_catalog",
        "pin_policy"
      ]
    },
    "actionDo": {
      "enum": [
        "edit_upstream",
        "bump_pin",
        "keep_both_checkouts",
        "keep_facade_reexport_canonical",
        "add_parity_test",
        "keep_parity_test",
        "document_known_divergent",
        "vendor_and_gate_drift",
        "choose_canonical",
        "ask_clarifying_questions",
        "ignore_analyzer_until_interview",
        "scope_query_keys",
        "rebuild_served_artifact",
        "refuse_overwrite_dirty_tree",
        "do_not_count_discovery_as_connected",
        "test_operator_and_admin_separately",
        "use_locale_catalog"
      ]
    },
    "forbidDo": {
      "enum": [
        "delete_either_tree",
        "delete_generated_mirror",
        "treat_analyzer_as_debt",
        "couple_standalone_to_foreign_monorepo",
        "fork_logic_into_consumer",
        "leak_query_across_modules",
        "treat_source_as_served",
        "overwrite_dirty_working_tree",
        "count_lan_scan_as_connected_agent",
        "treat_visible_edit_as_authorized",
        "hardcode_ui_locale"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "languages", "packaging", "analyzer"],
      "properties": {
        "subject": { "$ref": "#/$defs/identifier" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "packaging": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "analyzer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "kind", "treatAsDebtUntilInterview"],
          "properties": {
            "present": { "type": "boolean" },
            "kind": {
              "enum": ["code2llm-toon", "redup", "jscpd", "other", "none"]
            },
            "treatAsDebtUntilInterview": { "type": "boolean" }
          }
        }
      }
    },
    "pinPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "edit", "onChange", "forbid"],
      "properties": {
        "kind": { "const": "pin_policy" },
        "edit": { "enum": ["upstream", "local-only"] },
        "onChange": { "enum": ["bump_pin", "re_vendor", "none"] },
        "forbid": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/forbidDo" }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "canonical", "trees", "actions", "forbid"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/kind" },
        "canonical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {
            "ref": { "type": "string", "minLength": 1, "maxLength": 300 },
            "path": { "$ref": "#/$defs/relativePath" },
            "module": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "trees": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "facade": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "enum": ["parity_test", "pin_check", "none"] },
            "path": { "$ref": "#/$defs/relativePath" }
          }
        },
        "knownDivergent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": { "type": "string", "minLength": 1, "maxLength": 400 }
          }
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 800 },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["do"],
            "properties": {
              "do": { "$ref": "#/$defs/actionDo" },
              "target": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        },
        "forbid": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/forbidDo" }
        },
        "questions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  }
}
