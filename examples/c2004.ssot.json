{
  "$schema": "https://wellmanifest.dev/schemas/ssot/decision/v1",
  "schema": "wellmanifest.ssot/decision/v1",
  "id": "c2004.ssot",
  "version": "0.2.0",
  "purpose": "Reusable SSOT decisions from maskservice: dual-checkout, vendored parity, query namespaces, served dist, fleet inventory vs runtime, capability chrome, locale catalog.",
  "context": {
    "subject": "c2004.ssot",
    "languages": ["python", "javascript", "typescript"],
    "packaging": ["git-submodule", "npm", "vendored-copy", "facade-reexport"],
    "analyzer": {
      "present": true,
      "kind": "code2llm-toon",
      "treatAsDebtUntilInterview": false
    }
  },
  "policy": {
    "kind": "pin_policy",
    "edit": "upstream",
    "onChange": "bump_pin",
    "forbid": [
      "delete_generated_mirror",
      "treat_analyzer_as_debt",
      "couple_standalone_to_foreign_monorepo",
      "fork_logic_into_consumer"
    ]
  },
  "decisions": [
    {
      "id": "c2004.backend-shared-py",
      "kind": "generated_mirror",
      "canonical": {
        "ref": "github:oqlos/backend-shared-py",
        "path": "packages/backend-shared-py"
      },
      "trees": [
        "packages/backend-shared-py",
        "extern/oqlos/packages/backend-shared-py"
      ],
      "rationale": "Dual git-submodule checkouts of the same package are generated deployment mirrors, not forks. redup/code2llm will report exact copies; that is expected. Edit upstream backend-shared-py and bump the pin. Do not delete either tree without redesigning oqlos packaging.",
      "actions": [
        { "do": "edit_upstream", "target": "github:oqlos/backend-shared-py" },
        { "do": "bump_pin", "target": "c2004" },
        { "do": "keep_both_checkouts" }
      ],
      "forbid": ["delete_either_tree", "delete_generated_mirror"]
    },
    {
      "id": "c2004.frontend-services-parity",
      "kind": "vendored_copy",
      "canonical": {
        "ref": "packages/frontend-services",
        "path": "packages/frontend-services"
      },
      "trees": [
        "packages/frontend-services/src/wsClient.js",
        "extern/oqlos/frontend/src/api/wsClient.js",
        "packages/frontend-services/src/designRem.js",
        "extern/oqlos/frontend/src/utils/designRem.js",
        "packages/frontend-services/src/hardware-api-retry.js",
        "extern/oqlos/frontend/src/api/hardware-api-retry.js",
        "packages/hardware-client-ts/src/index.ts",
        "extern/oqlos/frontend/vendor/hardware-client/index.ts"
      ],
      "gate": {
        "kind": "parity_test",
        "path": "tests/test_frontend_services_oqlos_parity.py"
      },
      "rationale": "extern/oqlos cannot import across the repository boundary, so it carries vendored copies. Identical pairs must stay byte-identical. A standalone product must vendor and gate drift instead of coupling to another monorepo just to import SSOT.",
      "actions": [
        { "do": "keep_parity_test", "target": "tests/test_frontend_services_oqlos_parity.py" },
        { "do": "vendor_and_gate_drift" }
      ],
      "forbid": ["couple_standalone_to_foreign_monorepo"]
    },
    {
      "id": "c2004.parent-url-bridge",
      "kind": "allowed_divergence",
      "canonical": {
        "ref": "packages/frontend-services/src/parentUrlBridge.js",
        "path": "packages/frontend-services/src/parentUrlBridge.js"
      },
      "trees": [
        "packages/frontend-services/src/parentUrlBridge.js",
        "extern/oqlos/frontend/src/utils/parentUrlBridge.js"
      ],
      "knownDivergent": {
        "reason": "Different postMessage protocols by design; each copy has its own host listener. Sharing one message type would cross-talk."
      },
      "rationale": "jscpd reports clones; the remaining review work is actionable twins versus allowed-divergent copies. parentUrlBridge is the latter.",
      "actions": [
        { "do": "document_known_divergent" }
      ],
      "forbid": []
    },
    {
      "id": "c2004.hardware-client-facade",
      "kind": "facade",
      "canonical": {
        "ref": "oqlos.hardware.client",
        "module": "oqlos.hardware.client"
      },
      "trees": [
        "packages/hardware-client-py",
        "oqlos/oqlos/hardware/client"
      ],
      "facade": {
        "path": "packages/hardware-client-py"
      },
      "rationale": "The hardware client facade re-exports the canonical oqlos.hardware.client implementation. Do not copy tic249_* or other client logic into the consumer.",
      "actions": [
        { "do": "keep_facade_reexport_canonical", "target": "oqlos.hardware.client" }
      ],
      "forbid": ["fork_logic_into_consumer"]
    },
    {
      "id": "c2004.query-namespace",
      "kind": "query_namespace",
      "canonical": {
        "ref": "frontend/src/services/uri-query-dsl.ts",
        "path": "frontend/src/services/uri-query-dsl.ts"
      },
      "trees": [
        "frontend/src/services/shell-routing.service.ts",
        "frontend/src/services/uri-query-dsl.ts",
        "connect-config/frontend/src/modules/connect-config/pages/connect-config-process-capabilities.page.ts"
      ],
      "rationale": "Hardware COMMAND/ADDRESS keys must not leak into process-capability URI DSL. wellmanifest.dsl unknownPolicy=reject; strip on navigate and on arrival.",
      "actions": [
        { "do": "scope_query_keys", "target": "frontend/src/services/uri-query-dsl.ts" }
      ],
      "forbid": ["leak_query_across_modules"]
    },
    {
      "id": "c2004.served-artifact",
      "kind": "served_artifact",
      "canonical": {
        "ref": "frontend/dist",
        "path": "frontend/dist"
      },
      "trees": [
        "frontend/src",
        "frontend/dist",
        "scripts/build-frontend-if-stale.sh"
      ],
      "rationale": "nginx serves frontend/dist with no HMR. Source edits are not live until rebuild, reload, and a hard refresh. TestQL WAIT must follow the served bundle, not the editor buffer.",
      "actions": [
        { "do": "rebuild_served_artifact", "target": "frontend/dist" }
      ],
      "forbid": ["treat_source_as_served"]
    },
    {
      "id": "c2004.inventory-vs-runtime",
      "kind": "inventory_vs_runtime",
      "canonical": {
        "ref": "update/fleet_proxy",
        "path": "update/fleet_proxy"
      },
      "trees": [
        "update/fleet_proxy/discovery.py",
        "update/fleet_proxy"
      ],
      "rationale": "LAN scan, connected websocket agents, and applied git revision are three truths. Fail-closed deploy must refuse a dirty tree (wellmanifest.deployment deploy-source-exact).",
      "actions": [
        { "do": "do_not_count_discovery_as_connected" },
        { "do": "refuse_overwrite_dirty_tree" }
      ],
      "forbid": [
        "count_lan_scan_as_connected_agent",
        "overwrite_dirty_working_tree"
      ]
    },
    {
      "id": "c2004.capability-surface",
      "kind": "capability_surface",
      "canonical": {
        "ref": "testql-testing/scenarios/gui-connect-id.testql.toon.yaml",
        "path": "testql-testing/scenarios/gui-connect-id.testql.toon.yaml"
      },
      "trees": [
        "testql-testing/scenarios/gui-connect-id.testql.toon.yaml",
        "connect-id/frontend"
      ],
      "rationale": "Visible Edit is chrome, not a write grant. Operator 403/429 on API writes while admin/system can mutate is expected. TestQL must cover both roles.",
      "actions": [
        { "do": "test_operator_and_admin_separately" }
      ],
      "forbid": ["treat_visible_edit_as_authorized"]
    },
    {
      "id": "c2004.locale-catalog",
      "kind": "locale_catalog",
      "canonical": {
        "ref": "frontend/src/i18n",
        "path": "frontend/src/i18n"
      },
      "trees": [
        "connect-config/frontend/src/modules/connect-config/pages/connect-config-process-capabilities.page.ts"
      ],
      "rationale": "Hardcoded Polish headings stay Polish when lang=en. Operator-facing copy belongs in the locale catalog, not page-local getContent() strings.",
      "actions": [
        { "do": "use_locale_catalog", "target": "frontend/src/i18n" }
      ],
      "forbid": ["hardcode_ui_locale"]
    }
  ],
  "questions": []
}
